{
  "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
  // audit-ci supports reading JSON, JSONC, and JSON5 config files.
  // Only use one of ["low": true, "moderate": true, "high": true, "critical": true]
  "moderate": true,
  "allowlist": [
    // NOTE: Please add as much information as possible to any items added to the allowList
    //
    // Only one advisory in this tree has no fix in any version. Everything else is patched
    // with a real npm override in package.json rather than suppressed here.
    //
    // GHSA-848j-6mx2-7j84 - elliptic (low): no patched release exists in any major - the
    // advisory covers "<= 6.6.1" and 6.6.1 is the newest version published. It arrives via
    // vite-plugin-node-polyfills -> node-stdlib-browser -> crypto-browserify ->
    // browserify-sign / create-ecdh, all already at their latest versions, and those
    // polyfills need elliptic for ECDH/ECDSA, so no parent bump removes it either.
    // Low severity, below this config's "moderate" threshold; listed for completeness.
    "GHSA-848j-6mx2-7j84"
  ]
}
